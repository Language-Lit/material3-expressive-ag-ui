{
  "name": "@language-lit/material3-expressive-ag-ui",
  "version": "0.1.0",
  "description": "Material 3 Expressive chat and agent components for the AG-UI protocol — a React-free event projection, an agent binding hook, and conformant M3 surfaces for streaming text, reasoning, tool calls, and activity.",
  "license": "MIT",
  "homepage": "https://m3e.language-lit.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Language-Lit/material3-expressive-ag-ui.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js",
      "default": "./dist/protocol.js"
    },
    "./styles.css": "./dist/styles.css",
    "./copilotkit": {
      "types": "./dist/copilotkit.d.ts",
      "import": "./dist/copilotkit.js",
      "default": "./dist/copilotkit.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/add-directives.mjs && npm run build:styles",
    "build:styles": "node scripts/build-styles.mjs",
    "dev": "tsup --watch",
    "playground": "vite --config playground/vite.config.ts --port 5273 --strictPort",
    "playground:build": "vite build --config playground/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "verify:package": "node scripts/verify-package.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run verify:package"
  },
  "peerDependencies": {
    "@ag-ui/client": ">=0.0.50",
    "@ag-ui/core": ">=0.0.50",
    "@copilotkit/react-core": "~1.71.0",
    "@copilotkit/react-ui": "~1.71.0",
    "@language-lit/material3-expressive": "^1.2.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@copilotkit/react-core": {
      "optional": true
    },
    "@copilotkit/react-ui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ag-ui/client": "0.0.59",
    "@ag-ui/core": "0.0.59",
    "@copilotkit/react-core": "1.71.0",
    "@copilotkit/react-ui": "1.71.0",
    "@language-lit/material3-expressive": "^1.2.2",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "20.19.43",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "^29.1.1",
    "lightningcss": "1.32.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rxjs": "7.8.1",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vite": "8.1.5",
    "vitest": "4.1.11"
  },
  "keywords": [
    "ag-ui",
    "agent-user-interaction",
    "agent-ui",
    "ai-agents",
    "chat-ui",
    "generative-ui",
    "material-design",
    "material-3",
    "material-3-expressive",
    "react",
    "design-system"
  ],
  "browserslist": [
    "Chrome >= 120",
    "Edge >= 120",
    "Firefox >= 121",
    "Safari >= 17.2",
    "iOS >= 17.2"
  ]
}
